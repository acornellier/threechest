WCL_CLIENT_ID=
WCL_CLIENT_SECRET=

# Vercel Blob store holding the WCL-ranked sample routes.
# Read/write token for the sync scripts (yarn rankings:download / rankings:upload).
BLOB_READ_WRITE_TOKEN=
# Public base URL of that store, e.g. https://<store-id>.public.blob.vercel-storage.com
# Also needs setting in the Vercel project env, or the sample routes dropdown shows easy routes only.
VITE_RANKINGS_BASE_URL=
